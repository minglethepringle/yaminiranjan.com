---
layout: base.njk
title: Contact
permalink: /contact/
---
<section class="page-hero page-hero--contact">
  <h1>Contact</h1>
</section>

<section class="contact">
  <div class="contact__intro">
    <h2>Let's chat!</h2>
    <p>If you&rsquo;d like to meet virtually on a call, you can book a consultation meeting through Calendly by clicking the button below. Otherwise, feel free to send an email by filling out the contact form. I look forward to getting in contact with you!</p>
    <a class="btn" href="https://calendly.com/yaminiranjan" target="_blank" rel="noopener">Book Consultation Call</a>
  </div>

  {#- Static hosting has no server to receive the form; it posts to the endpoint in src/_data/site.json. #}
  <form class="contact-form" action="{{ site.contactFormAction }}" method="POST">
    <label for="name">Name <span class="req">*</span></label>
    <input id="name" name="name" type="text" required>

    <label for="email">Email <span class="req">*</span></label>
    <input id="email" name="email" type="email" required>

    <label for="topic">Inquiry Topic <span class="req">*</span></label>
    <select id="topic" name="topic" required>
      <option>Podcast Producing</option>
      <option>Podcast Hosting</option>
      <option>Podcast Editing</option>
      <option>Sound Editing / Mixing</option>
      <option>Sound Design</option>
      <option>Speaking Engagements</option>
      <option>Other</option>
    </select>

    <label for="subject">Subject</label>
    <input id="subject" name="subject" type="text">

    <label for="message">Message <span class="req">*</span></label>
    <textarea id="message" name="message" rows="5" required></textarea>

    <button class="btn" type="submit">Submit</button>
  </form>
</section>
