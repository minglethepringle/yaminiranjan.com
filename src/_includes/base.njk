{%- set nav = [
  { title: "Home", url: "/" },
  { title: "About", url: "/about/" },
  { title: "Services", url: "/services/" },
  { title: "Portfolio", url: "/portfolio/" },
  { title: "Testimonials", url: "/testimonials/" },
  { title: "Contact", url: "/contact/" }
] -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} - {% endif %}Yamini Ranjan</title>
  <meta name="description" content="{{ description or 'Yamini Ranjan — podcaster, producer, and marketer. Podcast producing, sound editing, podcast editing, and speaking.' }}">
  <link rel="icon" href="/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Heebo:wght@500;700&family=Karla:ital,wght@0,400;0,600;1,600&family=Roboto:wght@500&display=swap">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body class="{{ bodyClass }}">
  <header class="site-header">
    <a class="logo" href="/"><img src="/assets/img/logo.png" alt="Yamini Ranjan" width="50" height="50"></a>
    <button class="menu-toggle" aria-label="Main menu" aria-expanded="false" aria-controls="site-nav">
      <svg class="icon-open" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M2 4h16v2H2zm0 5h16v2H2zm0 5h16v2H2z"/></svg>
      <svg class="icon-close" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M5.05 3.64 10 8.59l4.95-4.95 1.41 1.41L11.41 10l4.95 4.95-1.41 1.41L10 11.41l-4.95 4.95-1.41-1.41L8.59 10 3.64 5.05z"/></svg>
    </button>
    <nav id="site-nav" class="site-nav">
      <ul>
        {%- for item in nav %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} class="current" aria-current="page"{% endif %}>{{ item.title }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </header>

  <main>
{{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>Copyright &copy; {{ "now" | year }} Yamini Ranjan</p>
    <p>Made by&nbsp;<a href="https://www.mingleli.com/" target="_blank" rel="noopener">Mingle Li</a></p>
  </footer>

  <script>
    const toggle = document.querySelector(".menu-toggle");
    toggle.addEventListener("click", () => {
      const open = document.body.classList.toggle("nav-open");
      toggle.setAttribute("aria-expanded", open);
    });
  </script>
</body>
</html>
